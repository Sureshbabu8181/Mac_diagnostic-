# Sunrise MDM environment (dev)
POSTGRES_USER=sunrise
POSTGRES_PASSWORD=sunrise_dev_password
POSTGRES_DB=sunrise
DATABASE_URL=postgres://sunrise:sunrise_dev_password@postgres:5432/sunrise?sslmode=disable

REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sunrise_minio
MINIO_SECRET_KEY=sunrise_minio_secret
MINIO_BUCKET=packages

JWT_SECRET=change-me-in-production
JWT_ISSUER=sunrise-mdm
TOKEN_TTL_MINUTES=15
REFRESH_TTL_HOURS=8

# Vault (optional in dev)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
