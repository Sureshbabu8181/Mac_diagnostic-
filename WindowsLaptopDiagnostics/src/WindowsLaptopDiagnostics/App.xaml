<Application x:Class="WindowsLaptopDiagnostics.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:WindowsLaptopDiagnostics.Infrastructure"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <inf:StatusToBrushConverter x:Key="StatusToBrush" />
            <inf:StatusToLabelConverter x:Key="StatusToLabel" />
            <inf:InverseBoolConverter x:Key="InverseBool" />
            <inf:BoolToVisibilityConverter x:Key="BoolToVis" />
            <inf:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
            <inf:KeyWidthConverter x:Key="KeyWidth" />
            <inf:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <inf:EmptyToVisibilityConverter x:Key="EmptyToVisibilityInverted" Invert="True" />
            <inf:ValueEqualsConverter x:Key="RouteEquals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
