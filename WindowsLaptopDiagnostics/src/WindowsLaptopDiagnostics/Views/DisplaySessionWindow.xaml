<Window x:Class="WindowsLaptopDiagnostics.Views.DisplaySessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp"
        MouseMove="OnMouseMove" MouseLeftButtonDown="OnMouseLeftDown"
        MouseRightButtonDown="OnMouseRightDown"
        Loaded="OnLoaded" Closed="OnClosed"
        Focusable="True"
        Title="Display Pattern Session">

    <Window.Resources>
        <Style x:Key="SessionGhost" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SessionAccent" TargetType="Button">
            <Setter Property="Background" Value="#FF22D3EE" />
            <Setter Property="Foreground" Value="#FF0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF67E8F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Black">

        <!-- Pattern surface (rendered in code-behind) -->
        <Canvas x:Name="PatternCanvas" ClipToBounds="True" />

        <!-- Auto-hiding translucent control overlay -->
        <Border x:Name="Overlay"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#B30F172A" Padding="22,14"
                MouseEnter="OnOverlayEnter" MouseLeave="OnOverlayLeave">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevBtn" Content="◀  Previous" Style="{StaticResource SessionGhost}" Click="OnPrev" />
                    <Button x:Name="PauseBtn" Content="Pause" Style="{StaticResource SessionGhost}" Margin="10,0,0,0" Click="OnPause" />
                    <Button x:Name="NextBtn" Content="Next  ▶" Style="{StaticResource SessionGhost}" Margin="10,0,0,0" Click="OnNext" />
                    <Button x:Name="RestartBtn" Content="Restart" Style="{StaticResource SessionGhost}" Margin="10,0,0,0" Click="OnRestart" />
                    <Button x:Name="ExitBtn" Content="Exit  (Esc)" Style="{StaticResource SessionAccent}" Margin="10,0,0,0" Click="OnExit" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubText" Text="" Foreground="#FF94A3B8" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Paused indicator -->
        <Border x:Name="PausedBadge"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#CCDC2626" CornerRadius="8" Padding="30,16" Visibility="Collapsed">
            <TextBlock Text="PAUSED — press P or Space to resume" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- Pattern description hint (bottom, auto-hides with overlay) -->
        <Border x:Name="HintBar"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="#B30F172A" Padding="22,12">
            <TextBlock x:Name="HintText" Text="" Foreground="#FFCBD5E1" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- Footer status (always visible: keyboard hints) -->
        <Border x:Name="Footer"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0"
                Background="#80000000" CornerRadius="6" Padding="14,7" Opacity="0.85">
            <TextBlock Text="←/→ pattern   ·   Space pause   ·   R restart   ·   Esc exit"
                       Foreground="#FFCBD5E1" FontSize="11" />
        </Border>
    </Grid>
</Window>
