<UserControl x:Class="WindowsLaptopDiagnostics.Views.GpuStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsLaptopDiagnostics.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="GPU Stress Test" Style="{StaticResource TitleText}" />
            <TextBlock Text="Adapter inventory, live telemetry, and a bounded rendering workload with cancel"
                       Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Adapters + live telemetry -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Display adapters" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}"
                                                           HorizontalAlignment="Right" FontSize="11"
                                                           VerticalAlignment="Top" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Driver}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,10" />
                        <TextBlock Text="Live telemetry" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding TelemetryLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource MutedText}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Rendering workload surface: particles are created in code-behind -->
                        <TextBlock Text="Rendering workload" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="6" Height="200" ClipToBounds="True">
                            <Canvas x:Name="RenderSurface" ClipToBounds="True" IsHitTestVisible="False" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Workload + result -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Rendering workload" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <TextBlock Text="Duration" Style="{StaticResource MutedText}" FontSize="11" />
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:GpuStressViewModel.DurationOptions}}"
                                      SelectedItem="{Binding DurationSeconds}" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Start" Style="{StaticResource AccentButton}"
                                        Command="{Binding StartCommand}" Padding="14,7" />
                                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Command="{Binding CancelCommand}" Padding="14,7" />
                                <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Command="{Binding ResetCommand}" Padding="14,7" />
                            </StackPanel>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" FontFamily="Consolas" DockPanel.Dock="Right" />
                                <TextBlock Text="Progress" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource ThinProgress}" Height="8" Margin="0,6,0,0"
                                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />

                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding WorkloadNote}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource FailedBrush}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Error, Converter={StaticResource EmptyToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
