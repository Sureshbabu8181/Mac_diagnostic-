<UserControl x:Class="WindowsLaptopDiagnostics.Views.TouchpadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsLaptopDiagnostics.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="Touchpad &amp; Mouse" Style="{StaticResource TitleText}" />
            <TextBlock Text="Guided pointer input: coordinates, clicks, drag and scroll on a defined surface"
                       Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Test surface -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Test surface" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding CoordsText}" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Right" FontFamily="Consolas" />
                        </DockPanel>

                        <Border x:Name="Surface"
                                Background="#FF0B1220"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                CornerRadius="6" Height="360" ClipToBounds="True"
                                MouseMove="OnMouseMove" MouseLeftButtonDown="OnLeftDown"
                                MouseLeftButtonUp="OnLeftUp" MouseRightButtonDown="OnRightDown"
                                MouseWheel="OnWheel" MouseLeave="OnMouseLeave">
                            <Grid>
                                <!-- Corner markers so edge-reaching is obvious -->
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                                        Background="#3322D3EE" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="0,0" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                </Border>
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6"
                                        Background="#3322D3EE" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="MaxLabel" Text="" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                </Border>
                                <!-- IsHitTestVisible=False is essential: the trail
                                     dot is drawn under the cursor. If the canvas were
                                     hit-testable, repainting would change the element
                                     under the cursor, re-raise MouseMove, repaint...
                                     a runaway loop that floods the UI thread. -->
                                <Canvas x:Name="TrailCanvas" ClipToBounds="True" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Clear Trail" Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearTrailCommand}" />
                            <Button Content="Reset Counters" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding ResetCommand}" />
                            <TextBlock Text="{Binding PathText}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live readings + checklist -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live coordinates" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="X" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding X, StringFormat={}{0:F0}}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="20" FontWeight="SemiBold" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Y" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding Y, StringFormat={}{0:F0}}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="20" FontWeight="SemiBold" FontFamily="Consolas" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Counters" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,2">
                                    <Run Text="Moves: " Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding MoveEvents, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,2">
                                    <Run Text="Left: " Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding LeftClicks, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,2">
                                    <Run Text="Right: " Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding RightClicks, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,2">
                                    <Run Text="Wheel: " Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding WheelNotches, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,2" Grid.ColumnSpan="2">
                                    <Run Text="Drags: " Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding DragOperations, Mode=OneWay}" />
                                    <Run Text="   " />
                                    <Run Text="{Binding DragStateText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                </TextBlock>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Honest source attribution -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Input source" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,4"
                                    HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="{Binding PointerSource}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding SourceExplanation}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="Devices reported by Windows" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding PointingDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Checklist -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Observed checks" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="Each row reflects an event actually received while this page was active. A blank row means that behaviour has not been observed yet — it is never assumed to pass."
                               Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Checklist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0,3"
                                           FontFamily="Consolas" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
                    <TextBlock Text="Manual confirmation" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="Confirm only if you physically used the built-in touchpad and it responded. An attached mouse moving the pointer does not prove the touchpad works."
                               Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="I used the touchpad — it responded" Style="{StaticResource GhostButton}"
                                Command="{Binding ConfirmCommand}" />
                        <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding UnconfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
