<UserControl x:Class="WindowsLaptopDiagnostics.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsLaptopDiagnostics.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="Camera Test" Style="{StaticResource TitleText}" />
            <TextBlock Text="Live preview with real frame count and FPS measured from delivered frames"
                       Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Preview -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Live preview" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding ActualResolution}" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Right" FontFamily="Consolas" />
                        </DockPanel>

                        <Border Background="#FF0B1220" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="6" ClipToBounds="True" Height="380">
                            <Grid>
                                <TextBlock x:Name="IdleText" Text="No preview — press Start"
                                           Foreground="{StaticResource MutedBrush}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                            </Grid>
                        </Border>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Scan for cameras" Style="{StaticResource GhostButton}"
                                    Command="{Binding ScanCommand}" Padding="14,7" />
                            <Button Content="Start" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                                    Command="{Binding StartCommand}" Padding="14,7" />
                            <Button Content="Stop" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding StopCommand}" Padding="14,7" />
                            <Button Content="Restart" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding RestartCommand}" Padding="14,7" />
                            <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding ResetCommand}" Padding="14,7" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource FailedBrush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource EmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Readings + results -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Detected cameras" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Cameras}"
                                      SelectedItem="{Binding SelectedCamera}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="Camera " /><Run Text="{Binding Index, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding DeviceInfo}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Measured readings" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Frames delivered" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding FrameCount, Mode=OneWay}"
                                               Foreground="{StaticResource AccentBrush}" FontSize="20"
                                               FontWeight="SemiBold" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Measured FPS" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding MeasuredFps, Mode=OneWay, StringFormat={}{0:0.0}}"
                                               Foreground="{StaticResource AccentBrush}" FontSize="20"
                                               FontWeight="SemiBold" FontFamily="Consolas" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Measured FPS is counted from frames the device actually delivered over the last 2-second window; it is not taken from the advertised rate."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Observed checks" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Checklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0,3"
                                                   FontFamily="Consolas" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
                            <TextBlock Text="Is the picture clear?"
                                       Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="Confirm only if you can see a sharp, correctly oriented, non-frozen image. Exposure and focus problems are real faults worth reporting."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <CheckBox Content="Yes — clear, upright and updating picture"
                                      IsChecked="{Binding UserConfirmed, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
