<UserControl x:Class="WindowsLaptopDiagnostics.Views.MicrophoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsLaptopDiagnostics.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="Microphone Test" Style="{StaticResource TitleText}" />
            <TextBlock Text="Live level meter and waveform, clipping detection, then record and play back"
                       Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Capture setup + waveform -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Input device" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sample rate" Style="{StaticResource MutedText}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:MicrophoneViewModel.SampleRates}}"
                                          SelectedItem="{Binding SampleRate}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Channels" Style="{StaticResource MutedText}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:MicrophoneViewModel.ChannelCounts}}"
                                          SelectedItem="{Binding Channels}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Live waveform -->
                        <TextBlock Text="Waveform" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
                        <Border x:Name="WaveSurface" Background="#FF0B1220"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                CornerRadius="6" Height="170" ClipToBounds="True">
                            <Canvas x:Name="WaveCanvas" ClipToBounds="True" IsHitTestVisible="False" />
                        </Border>

                        <!-- Level meter -->
                        <TextBlock Text="Input level" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Height="16"
                                HorizontalAlignment="Stretch">
                            <Border x:Name="LevelBar" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" Width="0" CornerRadius="4" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource BodyText}" FontFamily="Consolas">
                                <Run Text="Now: " Foreground="{StaticResource MutedBrush}" />
                                <Run Text="{Binding Level, Mode=OneWay, StringFormat={}{0:0.0} dBFS}" />
                                <Run Text="    Peak: " Foreground="{StaticResource MutedBrush}" />
                                <Run Text="{Binding Peak, Mode=OneWay, StringFormat={}{0:0.0} dBFS}" />
                                <Run Text="    " />
                                <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding ClipText}" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start capture" Style="{StaticResource AccentButton}"
                                    Command="{Binding StartCommand}" Padding="14,7" />
                            <Button Content="Stop" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding StopCommand}" Padding="14,7" />
                            <Button Content="Play recording" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding PlayCommand}" Padding="14,7" />
                            <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding DeleteCommand}" Padding="14,7" />
                            <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding ResetCommand}" Padding="14,7" />
                        </StackPanel>

                        <TextBlock Text="{Binding FormatInfo}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource FailedBrush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource EmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Results -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Observed checks" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <TextBlock Text="Rows reflect the captured signal and your own confirmation. Capture stops when you leave this page."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Checklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0,3"
                                                   FontFamily="Consolas" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
                            <TextBlock Text="Did you hear your recording clearly?"
                                       Style="{StaticResource CardTitle}" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <TextBlock Text="Recorded audio plays back only if a recording was captured. Mark this yourself — the app cannot hear what came out of the speakers."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <CheckBox Content="Yes — playback was clear and recognisable"
                                      IsChecked="{Binding UserHeard, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="How this is judged" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="Level, peak and clipping come from the real captured samples, so a dead or muted microphone shows as a floor-level reading rather than a fabricated one. That proves capture only; whether the signal was intelligible is your call after playback."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
