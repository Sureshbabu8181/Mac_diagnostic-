<UserControl x:Class="WindowsLaptopDiagnostics.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsLaptopDiagnostics.ViewModels"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="2.5" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Tested">
                    <Setter Property="Background" Value="#FF14532D" />
                    <Setter Property="BorderBrush" Value="#FF22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Pressed">
                    <Setter Property="Background" Value="#FF22D3EE" />
                    <Setter Property="BorderBrush" Value="#FF67E8F9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="Keyboard Test" Style="{StaticResource TitleText}" />
            <TextBlock Text="Press keys to highlight them and measure physical key coverage"
                       Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <!-- Controls + live stats -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Start Monitoring" Style="{StaticResource AccentButton}"
                                    Command="{Binding StartCommand}" />
                            <Button Content="Stop" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding StopCommand}" />
                            <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding ResetCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PassedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Key identity only — no characters or typed text are captured"
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="COVERAGE" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding CoverageText}" Foreground="{StaticResource AccentBrush}"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PROGRESS" Style="{StaticResource MutedText}" FontSize="11" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Height="8" Margin="0,6,14,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding CoveragePercent, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PRESS EVENTS" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding TotalPressesObserved}" Foreground="{StaticResource TextBrush}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="AUTO-REPEATS" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding RepeatEvents}" Foreground="{StaticResource TextBrush}" FontSize="15" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding LastKeyText}" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <!-- On-screen keyboard -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                        <TextBlock Text="Untested" Style="{StaticResource MutedText}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="3" Background="#FF22D3EE" VerticalAlignment="Center" />
                        <TextBlock Text="Pressed" Style="{StaticResource MutedText}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="3" Background="#FF14532D" BorderBrush="#FF22C55E"
                                BorderThickness="1" VerticalAlignment="Center" />
                        <TextBlock Text="Tested" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Each row stays intact (no mid-row wrap); the board
                         scrolls horizontally on narrow windows. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KeyCap}"
                                                        Width="{Binding Width, Converter={StaticResource KeyWidth}}"
                                                        ToolTip="{Binding Label, StringFormat='Key: {0}  ·  presses: {1}'}">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Honest limitations -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Keys that cannot be captured reliably" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{x:Static vm:KeyboardViewModel.UncapturableKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="•" Foreground="{StaticResource WarningBrush}" DockPanel.Dock="Left" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="Coverage below 100% means some keys were never exercised. Pressing a key proves the key event was received — it does not by itself prove every physical key works; use the coverage figure together with a manual sweep for keys outside this layout." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
