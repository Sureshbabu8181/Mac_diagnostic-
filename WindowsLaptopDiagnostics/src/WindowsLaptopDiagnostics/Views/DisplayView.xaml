<UserControl x:Class="WindowsLaptopDiagnostics.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="Display Test" Style="{StaticResource TitleText}" />
            <TextBlock Text="Full-screen colour, gradient and geometry patterns for manual panel inspection"
                       Style="{StaticResource MutedText}" Margin="0,2,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Monitor selection + mode info -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Display" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding DisplayCountText}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Displays}"
                                  SelectedItem="{Binding SelectedDisplay}"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource SurfaceAltBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Padding="10,7" FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding FriendlyName, Mode=OneWay}" />
                                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                                        <Run Text="{Binding DeviceName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                                        <Run Text="{Binding RefreshHz, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        <Run Text=" Hz" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Current mode" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding ModeSummary}" Style="{StaticResource BodyText}" />

                        <TextBlock Text="Supported modes" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding ModeList}" Style="{StaticResource MutedText}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <!-- Instructions -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="How to use" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                   Text="Start the full-screen test on the selected display, then step through each pattern. Look for pixels that stay dark on white, stay bright on black, or show the wrong colour." />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                   Text="Move the mouse or press a key to bring the controls back; they auto-hide. Esc exits and restores the previous window state." />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Pattern switching is automated. Dead and stuck pixel detection is a manual visual inspection recorded below — no automatic pixel detection is claimed." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pattern list -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Patterns" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Patterns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Manual inspection + start -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Manual inspection (required for a pass)" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ManualStatus}" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource PassedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ManualPixelsConfirmed}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="I inspected — no dead or stuck pixels" Style="{StaticResource GhostButton}"
                                Command="{Binding ConfirmPixelsCommand}" />
                        <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding ResetManualCommand}" />
                    </StackPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,16,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start Full-Screen Test" Style="{StaticResource AccentButton}"
                                Command="{Binding StartCommand}" />
                        <TextBlock Text="{Binding SelectedDisplay.FriendlyName, FallbackValue='No display selected'}"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
