<UserControl x:Class="WindowsLaptopDiagnostics.Views.ThermalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <TextBlock Text="Temperature &amp; Sensors" Style="{StaticResource TitleText}" />
            <TextBlock Text="Every reading names its source; absent sensors report Unsupported rather than a guess"
                       Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="12,6" />
                            <TextBlock Text="Sensor readings" Style="{StaticResource CardTitle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource FailedBrush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource EmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Why a sensor may be unavailable" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="How this is judged" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="Thermal and fan sensors are firmware decisions, not application ones: most consumer laptops never expose a tachometer, and ACPI thermal zones commonly require administrator rights. This page distinguishes 'needs elevation' from 'not exposed at all' so you know whether running elevated would help. Utilisation, clock and the performance-limit flag come from Windows processor counters and are live measurements."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
