<UserControl x:Class="WindowsLaptopDiagnostics.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Timestamp}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="Run Diagnostics" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding RunDiagnosticsCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource TitleText}" />
                    <TextBlock Text="Live hardware inventory from Windows APIs" Style="{StaticResource MutedText}" />
                </StackPanel>
            </DockPanel>

            <!-- Busy indicator -->
            <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12" />

            <!-- Device hero card -->
            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding DeviceTitle}" Style="{StaticResource CardTitle}" FontSize="18" />
                    <TextBlock Text="{Binding DeviceSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Two-column grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hardware -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hardware" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding HardwareRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" DockPanel.Dock="Left" Width="120" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100"
                                     Value="{Binding MemoryUsedPercent, Mode=OneWay}" Height="8" />
                        <ItemsControl ItemsSource="{Binding ResourceRows}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" DockPanel.Dock="Left" Width="90" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Graphics" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding GpuRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" DockPanel.Dock="Top" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource MutedText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Storage" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding StorageRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" DockPanel.Dock="Top" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource MutedText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Power -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Power" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding PowerRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" DockPanel.Dock="Left" Width="110" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <Button Content="Display Test" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding OpenTestCommand}" CommandParameter="display" />
                            <Button Content="Keyboard Test" Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                    Command="{Binding OpenTestCommand}" CommandParameter="keyboard" />
                            <Button Content="System Info" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                    Command="{Binding OpenTestCommand}" CommandParameter="system" />
                            <Button Content="History" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding OpenTestCommand}" CommandParameter="history" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
