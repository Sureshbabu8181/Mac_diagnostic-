<UserControl x:Class="WindowsLaptopDiagnostics.Views.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                        Visibility="{Binding StatusLabel, Converter={StaticResource BoolToVisInverted}}">
                    <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <ContentPresenter Content="{Binding Body}" />
        </StackPanel>
    </Border>
</UserControl>
