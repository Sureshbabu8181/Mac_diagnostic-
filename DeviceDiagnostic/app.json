{
  "expo": {
    "name": "One Diagnose",
    "slug": "OneDiagnose",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "package": "com.onediagnose.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow One Diagnose to access your camera for testing."
        }
      ],
      [
        "expo-location",
        {
          "locationPermission": "Allow One Diagnose to access your location for GPS testing."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow One Diagnose to use Face ID for biometric testing."
        }
      ]
    ]
  }
}
