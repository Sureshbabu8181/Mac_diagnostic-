{
  "expo": {
    "name": "DeviceDiagnostic",
    "slug": "DeviceDiagnostic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.DeviceDiagnostic",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MAC Diagnostic to access your camera for testing."
        }
      ],
      [
        "expo-location",
        {
          "locationPermission": "Allow MAC Diagnostic to access your location for GPS testing."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MAC Diagnostic to use Face ID for biometric testing."
        }
      ]
    ]
  }
}
