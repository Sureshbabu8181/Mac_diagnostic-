{
  "expo": {
    "name": "One Diagnose",
    "slug": "OneDiagnose",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#87CEEB",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.onediagnose.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow One Diagnose to access your camera for testing."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow One Diagnose to access your microphone for audio testing."
        }
      ],
      [
        "expo-location",
        {
          "locationPermission": "Allow One Diagnose to access your location for GPS testing."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow One Diagnose to use Face ID for biometric testing."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Allow One Diagnose to access Bluetooth to check device presence for testing.",
          "neverForLocation": true
        }
      ]
    ]
  }
}
